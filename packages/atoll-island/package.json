{
  "name": "@solid-mvc/atoll-island",
  "version": "0.0.0",
  "description": "solid-mvc island adapter: <Island/> shell components + Solid universal renderer for @solid-mvc/atoll worker islands",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@solid-mvc/atoll": "*",
    "@solid-mvc/core": "*",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@atolljs/core": "^0.1.12",
    "@atolljs/islands": "^0.1.12",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/solid-mvc",
    "directory": "packages/atoll-island"
  },
  "license": "MIT"
}
