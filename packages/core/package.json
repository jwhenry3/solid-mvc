{
  "name": "@solid-mvc/core",
  "version": "0.0.0",
  "description": "Angular-inspired modules/DI/decorators + class-based JSX views rendered by SolidJS + signal reactivity",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.ts",
    "./dom": "./src/dom.ts",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "solid-js": "^1.9.15"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhenry3/solid-mvc",
    "directory": "packages/core"
  },
  "license": "MIT"
}
